# Local-only secrets; do not commit .env.
DB_URL_PANOPTES=postgresql+psycopg://READ_ONLY_USERNAME:CHANGE_ME@HOST:5432/DATABASE
# Default history window for ALL three sources (completed UTC days).
# 0 or unset = all available dates. A set-date-limit override in /data wins.
ANALYTICS_HISTORY_DAYS=0
# Location for three aggregate JSON snapshots and locking/status files.
ANALYTICS_DATA_DIR=.local/data
DASH_HOST=127.0.0.1
PORT=8050
DASH_DEBUG=false
